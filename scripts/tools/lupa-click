#!/bin/bash
T="${LUPA_API_TOKEN:-e6c1c2d2e9bc9ef3d898ffff4554f521d51538028fc912da90b28aba3cfc49fe}"
L="${LUPA_URL:-http://127.0.0.1:3036}"
H=(-H "Authorization: Bearer $T" -H "Content-Type: application/json")
[ "$1" = "--xy" ] && curl -s -X POST "${H[@]}" "$L/live/mouse-click" -d "{\"x\":$2,\"y\":$3}" && exit
[ "$1" = "--text" ] && curl -s -X POST "${H[@]}" "$L/live/eval" -d "{\"script\":\"const e=Array.from(document.querySelectorAll('a,button,input[type=submit]')).find(e=>(e.textContent||e.value).includes('$2'));e?e.click():'not found'\"}" && exit
curl -s -X POST "${H[@]}" "$L/live/click" -d "{\"selector\":\"$1\"}"
