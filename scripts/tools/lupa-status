#!/bin/bash
T="${LUPA_API_TOKEN:-e6c1c2d2e9bc9ef3d898ffff4554f521d51538028fc912da90b28aba3cfc49fe}"
L="${LUPA_URL:-http://127.0.0.1:3036}"
H=(-H "Authorization: Bearer $T" -H "Content-Type: application/json")
curl -s -H "Authorization: Bearer $T" "$L/live/status"
echo ""
curl -s -X POST "${H[@]}" "$L/live/eval" -d '{"script":"return {title:document.title,url:location.href,forms:document.forms.length,links:document.links.length}"}'
