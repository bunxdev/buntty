doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title BunTTY Grid
    style.
      *{margin:0;padding:0;box-sizing:border-box}
      html,body{height:100%;background:#0a0a0a;overflow:hidden;font-family:monospace}
      .grid{display:grid;grid-template-columns:repeat(#{cols},1fr);grid-template-rows:repeat(#{rows},1fr);gap:2px;height:100vh;height:100dvh;width:100vw;padding:2px}
      @media (max-width:768px){.grid{grid-template-columns:1fr;grid-auto-rows:minmax(300px,1fr);grid-template-rows:none;height:auto;min-height:100dvh}html,body{overflow:auto}}
      .grid iframe{width:100%;height:100%;border:1px solid #2a2a3e;border-radius:2px;background:#0a0a0a}
      .grid iframe:focus{border-color:#3498db}
      ::-webkit-scrollbar{width:8px;height:8px}
      ::-webkit-scrollbar-track{background:#0a0a0a}
      ::-webkit-scrollbar-thumb{background:#2a2a3e;border-radius:4px}
      ::-webkit-scrollbar-thumb:hover{background:#e74c3c}
      ::-webkit-scrollbar-corner{background:#0a0a0a}
  body
    - const tok = locals.token ? `&token=${encodeURIComponent(locals.token)}` : ""
    main.grid(aria-label="Terminales de agentes")
      each agent in agents
        - const q = `?agent=${encodeURIComponent(agent.name)}&role=${encodeURIComponent(agent.role)}&minimal=1${tok}`
        - const label = `${agent.name} — ${agent.role}`
        if agent.session > 3
          iframe(src=`//${host.split(':')[0]}:3001/${agent.session}${q}` title=label)
        else
          iframe(src=`/${agent.session}${q}` title=label)
