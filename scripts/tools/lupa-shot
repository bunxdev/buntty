#!/bin/bash
. "$(dirname "$(readlink -f "$0")")/_lupa.sh"
O="${2:-shot-$(date +%s).png}"
if [ -z "$1" ]; then curl -s -X POST -H "Authorization: Bearer $T" "$L/live/screenshot" -o "$O"
else
  [[ "$1" =~ ^https?:// ]] || { echo "error: solo URLs http(s)"; exit 1; }
  post "screenshot" "{\"url\":$(jstr "$1"),\"format\":\"png\"}" -o "$O"
fi
echo "$O ($(du -h "$O"|cut -f1))"
