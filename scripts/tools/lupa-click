#!/bin/bash
. "$(dirname "$(readlink -f "$0")")/_lupa.sh"
num='^-?[0-9]+(\.[0-9]+)?$'
if [ "$1" = "--xy" ]; then
  [[ "$2" =~ $num && "$3" =~ $num ]] || { echo "uso: lupa-click --xy <x> <y>"; exit 1; }
  post "live/mouse-click" "{\"x\":$2,\"y\":$3}"; exit
fi
[ "$1" = "--text" ] && { ev "const t=$(jstr "$2");const e=Array.from(document.querySelectorAll('a,button,input[type=submit]')).find(e=>(e.textContent||e.value||'').includes(t));return e?(e.click(),'ok'):'not found'"; exit; }
post "live/click" "{\"selector\":$(jstr "$1")}"
