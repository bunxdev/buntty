doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="dark")
    meta(name="theme-color" content="#0a0a0a")
    title BunTTY Grid
    style.
      :root{--bg:#0a0a0a;--line:#2a2a3e;--focus:#3498db;color-scheme:dark}
      *{margin:0;padding:0;box-sizing:border-box}
      html,body{height:100%;background:var(--bg);overflow:hidden;font-family:monospace}
      .grid{display:grid;grid-template-columns:repeat(#{cols},minmax(0,1fr));grid-template-rows:repeat(#{rows},minmax(0,1fr));gap:2px;height:100vh;height:100dvh;width:100%;padding:2px}
      @media (max-width:768px){.grid{grid-template-columns:minmax(0,1fr);grid-auto-rows:minmax(320px,1fr);grid-template-rows:none;height:auto;min-height:100dvh}html,body{overflow:auto}}
      .grid iframe{display:block;width:100%;height:100%;border:1px solid var(--line);border-top:2px solid var(--agent,var(--line));border-radius:2px;background:var(--bg)}
      .grid iframe:focus{border-color:var(--focus);outline:none}
      ::-webkit-scrollbar{width:8px;height:8px}
      ::-webkit-scrollbar-track{background:var(--bg)}
      ::-webkit-scrollbar-thumb{background:var(--line);border-radius:4px}
      ::-webkit-scrollbar-thumb:hover{background:#e74c3c}
      ::-webkit-scrollbar-corner{background:var(--bg)}
  body
    - const tok = locals.token ? `&token=${encodeURIComponent(locals.token)}` : ""
    //- Strip the port without breaking IPv6 literals like [::1]:3000
    - const hostname = host.replace(/:\d+$/, "")
    //- Only render the cells that fit: hidden iframes would still spawn shells
    - const visible = agents.slice(0, cols * rows)
    main.grid(aria-label="Terminales de agentes")
      each agent in visible
        - const color = /^#[0-9a-f]{3,8}$/i.test(agent.color || "") ? agent.color : ""
        - const q = `?agent=${encodeURIComponent(agent.name)}&role=${encodeURIComponent(agent.role)}${color ? `&color=${encodeURIComponent(color)}` : ""}&minimal=1${tok}`
        - const label = `${agent.name} — ${agent.role}`
        - const style = color ? `--agent:${color}` : undefined
        if agent.session > 3
          iframe(src=`//${hostname}:3001/${agent.session}${q}` title=label style=style)
        else
          iframe(src=`/${agent.session}${q}` title=label style=style)
