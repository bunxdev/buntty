#!/bin/bash
T="${LUPA_API_TOKEN:-e6c1c2d2e9bc9ef3d898ffff4554f521d51538028fc912da90b28aba3cfc49fe}"
L="${LUPA_URL:-http://127.0.0.1:3036}"
[ -z "$1" ] && echo "uso: lupa-eval \"return document.title\"" && exit 1
S=$([ "$1" = "-f" ] && cat "$2" || echo "$1")
J=$(printf '%s' "$S" | jq -Rs .)
curl -s -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" "$L/live/eval" -d "{\"script\":$J}"
